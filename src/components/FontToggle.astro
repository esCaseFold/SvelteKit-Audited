---
import { Icon } from '@astrojs/starlight/components';
const isHomePage = Astro.url.pathname === '/';
---

{!isHomePage && (
  <button id="font-toggle" type="button">
    <Icon name="seti:font" size="1rem" />
    <span class="label">Serif</span>
  </button>
)}

<script>
  const root = document.documentElement;
  const button = document.getElementById('font-toggle') as HTMLButtonElement | null;
  const label = document.querySelector('#font-toggle .label');

  function setFont(font: string) {
    console.log(font);
    root.dataset.font = font;
    localStorage.setItem('font-preference', font);

  if (button) {
    button.style.fontFamily =
      font === 'serif'
        ? 'system-ui, sans-serif'
        : 'Georgia, serif';
  }

    if (label) {
      label.textContent = 
        font === 'serif'
          ? ' Sans Serif'
          : ' Serif';
    }
  }

  setFont(
    localStorage.getItem('font-preference') || 'sans'
  );

  button?.addEventListener('click', () => {
    const next =
      root.dataset.font === 'sans'
        ? 'serif'
        : 'sans';

    setFont(next);
  });
</script>

<style>
  button {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    cursor: pointer;
  }
</style>