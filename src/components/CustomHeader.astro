---
import Header from '@astrojs/starlight/components/Header.astro';
import FontToggle from './FontToggle.astro';
const isHomePage =
Astro.url.pathname === '/' ||
Astro.url.pathname === '/index.html';
---

<div class="header-wrapper">
  <Header />

  {!isHomePage && (
    <div class="font-toggle-container">
      <FontToggle />
    </div>
  )}
</div>

<style>
  .header-wrapper {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .font-toggle-container {
    justify-self: end;
    margin-right: 1rem;
  }
</style>